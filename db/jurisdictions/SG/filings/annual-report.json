{
  "schema": 1,
  "id": "annual-report",
  "name": "Annual Report",
  "authority": "ACRA",
  "comparatives": 1,
  "variants": {
    "SFRS": {
      "statements": [
        {
          "id": "pl",
          "title": "Statement of Profit or Loss",
          "kind": "pl",
          "lines": [
            { "id": "revenue", "label": "Revenue", "side": "income", "subtypes": ["Revenue"] },
            { "id": "other_income", "label": "Other income", "side": "income", "subtypes": ["Other Income"] },
            { "id": "cost_of_revenue", "label": "Cost of revenue", "side": "expense", "subtypes": ["Cost of Revenue"] },
            { "id": "operating_expenses", "label": "Operating expenses", "side": "expense", "subtypes": ["Operating Expenses"] },
            { "id": "personnel", "label": "Personnel costs", "side": "expense", "subtypes": ["Personnel Costs"] },
            { "id": "depreciation", "label": "Depreciation", "side": "expense", "subtypes": ["Depreciation"] },
            { "id": "operating_result", "label": "Operating result", "sum": ["revenue", "other_income", "cost_of_revenue", "operating_expenses", "personnel", "depreciation"], "bold": true, "keep": true },
            { "id": "finance_income", "label": "Finance income", "side": "income", "subtypes": ["Financial Items"] },
            { "id": "result_before_tax", "label": "Result before tax", "sum": ["operating_result", "finance_income"], "bold": true, "keep": true },
            { "id": "tax", "label": "Income tax expense", "side": "expense", "subtypes": ["Tax"] },
            { "id": "profit_for_year", "label": "Profit for the year", "sum": ["result_before_tax", "tax"], "bold": true, "keep": true }
          ]
        },
        {
          "id": "bs",
          "title": "Statement of Financial Position",
          "kind": "bs",
          "lines": [
            { "id": "non_current_assets", "label": "Non-current assets", "side": "asset", "subtypes": ["Non-current Assets"], "keep": true },
            { "id": "current_assets", "label": "Current assets", "side": "asset", "subtypes": ["Current Assets"], "keep": true },
            { "id": "cash", "label": "Cash and cash equivalents", "side": "asset", "subtypes": ["Cash and Equivalents"], "keep": true },
            { "id": "total_assets", "label": "Total assets", "sum": ["non_current_assets", "current_assets", "cash"], "bold": true, "keep": true },
            { "id": "share_capital", "label": "Share capital", "side": "equity", "accounts": ["3010"], "keep": true },
            { "id": "retained_earnings", "label": "Retained earnings", "side": "equity", "accounts": ["3020"], "keep": true },
            { "id": "current_year_earnings", "label": "Current year earnings", "side": "equity", "accounts": ["3099"], "keep": true },
            { "id": "total_equity", "label": "Total equity", "sum": ["share_capital", "retained_earnings", "current_year_earnings"], "bold": true, "keep": true },
            { "id": "non_current_liabilities", "label": "Non-current liabilities", "side": "liability", "subtypes": ["Non-current Liabilities"] },
            { "id": "current_liabilities", "label": "Current liabilities", "side": "liability", "subtypes": ["Current Liabilities"], "keep": true },
            { "id": "total_eq_liab", "label": "Total equity and liabilities", "sum": ["total_equity", "non_current_liabilities", "current_liabilities"], "bold": true, "keep": true }
          ]
        }
      ],
      "notes": [
        {
          "id": "principles",
          "title": "Note 1 — Accounting principles",
          "template": "The financial statements of {company_name} (UEN {org_nr}) have been prepared in accordance with the Singapore Financial Reporting Standards (SFRS). The financial year covers {period_start} to {period_end}. The functional currency is {currency}."
        }
      ],
      "signatureBlock": "_____________________\nDirector\n\n_____________________\nDirector"
    }
  }
}
