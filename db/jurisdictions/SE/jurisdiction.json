{
  "schema": 1,
  "code": "SE",
  "name": "Sweden",
  "currency": "SEK",
  "reportingStandards": ["K2", "K3"],
  "defaultReportingStandard": "K2",
  "taxIdFormat": "^\\d{6}-\\d{4}$",
  "taxIdSruPrefix": "16",
  "taxAttributes": [
    { "key": "loss_cf", "label": "Unused loss carry-forward", "type": "amount", "perYear": true, "rollforward": "closing_to_opening", "default": 0 },
    { "key": "audited", "label": "Annual report has been audited", "type": "bool", "perYear": true, "default": false },
    { "key": "consultant", "label": "Consultant assisted in preparing the annual report", "type": "bool", "perYear": true, "default": false }
  ],
  "contactAttributes": [
    { "key": "address", "label": "Address" },
    { "key": "postnr", "label": "Postal code", "format": "^\\d{3}\\s?\\d{2}$", "required": true },
    { "key": "postort", "label": "City", "required": true },
    { "key": "contact_name", "label": "Contact name" },
    { "key": "contact_phone", "label": "Phone nr" },
    { "key": "contact_email", "label": "Email" }
  ],
  "closing": {
    "required": true,
    "retainedEarningsAccount": "2099",
    "closingAccount": "8999"
  },
  "fxRevaluation": {
    "monetaryTypes": ["Asset", "Liability"],
    "gainLossAccount": "7960"
  },
  "integrations": {
    "sie": { "export": true, "import": true }
  },
  "closeChecklist": [
    { "id": "vat_return_done", "op": "vat_return_done", "label": "VAT return lodged for the period (VAT-coded activity present)", "kind": "engine" },
    { "id": "contact_attrs_complete", "op": "contact_attrs_complete", "label": "SRU contact attributes complete (address, postal code, city)", "kind": "engine" },
    { "id": "loss_cf_set", "op": "tax_attr_set", "attr": "loss_cf", "label": "Unused loss carry-forward recorded for the period", "kind": "engine" },
    { "id": "arsstamma_held", "op": "manual", "label": "Årsstämma held (annual general meeting)", "kind": "manual" }
  ]
}
